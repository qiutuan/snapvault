{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SnapVault",
  "version": "0.1.0",
  "identifier": "com.snapvault.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "SnapVault",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 600
      }
    ],
    "security": { "csp": null },
    "trayIcon": { "iconPath": "icons/128x128.png", "iconAsTemplate": false }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/256x256.png", "icons/512x512.png"],
    "externalBin": []
  }
}
